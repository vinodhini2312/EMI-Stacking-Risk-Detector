# ==============================================================================
# EMI Stacking Risk Detector - Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure for your local/production environment.
# NEVER commit your actual .env file or real credentials to Git!

# Server Port (Cloud platforms like Render/Railway automatically inject PORT)
PORT=8080

# ------------------------------------------------------------------------------
# PostgreSQL Database (Production Configuration)
# ------------------------------------------------------------------------------
# Example for hosted PostgreSQL (Supabase, Neon, AWS RDS, Render PostgreSQL):
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host.com:5432/emiguard_db
# SPRING_DATASOURCE_USERNAME=your_db_username
# SPRING_DATASOURCE_PASSWORD=your_db_password
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------------------
# Local H2 Database (Default / Development)
# ------------------------------------------------------------------------------
# To use file-based H2 locally (zero configuration needed by default):
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/emiguard;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_H2_CONSOLE_ENABLED=true
